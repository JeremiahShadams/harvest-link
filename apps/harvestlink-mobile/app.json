{
  "expo": {
    "name": "HarvestLink",
    "slug": "harvestlink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/harvestlink-icon.png",
    "scheme": "harvestlink",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.harvestlink.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.harvestlink.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#214A38",
        "foregroundImage": "./assets/images/harvestlink-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/harvestlink-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HarvestLink to take produce photos for freshness guidance.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HarvestLink to select a produce photo for freshness guidance.",
          "cameraPermission": "Allow HarvestLink to capture produce for freshness guidance.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/harvestlink-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2E9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
