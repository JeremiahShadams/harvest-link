# Copy to .env.development.local for local work. Never commit real values.

# Supabase (used by both the Next.js app and the Expo app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects use the anon key name instead of the publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the mobile app finds the Next.js API (/api/shelf-scan) and report links.
# Use your machine's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
